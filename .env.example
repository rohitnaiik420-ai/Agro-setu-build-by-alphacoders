# AgroSetu AI Environment Configuration
# All variables below are OPTIONAL. The platform has sane defaults out-of-the-box.

# CORS allowed origins (comma-separated). Default is "*"
# For production on custom domain: https://yourdomain.com,https://agro-setu.vercel.app
ALLOWED_ORIGINS=*

# Optional: Custom SQLite database path (default is /tmp/agrosetu_data/agri_system.db on Vercel, or data/agri_system.db locally)
# DB_PATH=/tmp/agrosetu_data/agri_system.db

# Optional port for local server
PORT=8000
