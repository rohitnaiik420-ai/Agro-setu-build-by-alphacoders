{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/farmers(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/buyers(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/products(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/orders(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/vehicles(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/shipments(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/forecast(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/route(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/iot(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/food(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/shelf(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/health",
      "dest": "api/index.py"
    },
    {
      "src": "/network-info",
      "dest": "api/index.py"
    },
    {
      "src": "/corridors(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/reset-data",
      "dest": "api/index.py"
    },
    {
      "src": "/docs(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "api/index.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "frontend/$1"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|map))",
      "dest": "frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/index.html"
    }
  ]
}

